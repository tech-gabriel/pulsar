<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ea17739f-3429-4487-950a-7d2eedbdb78d</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Transitivo de Microsoft.AspNetCore.OpenApi, que resolve 2.0.0. Fixado
         direto porque 2.0.0 tem vulnerabilidade alta (GHSA-v5pm-xwqc-g5wc,
         corrigida em 2.7.5). Remover quando o pacote pai subir sozinho. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Transitivo de Resend, que resolve 8.0.20 nos projetos sem o framework web
         (Pulsar.Tests e Pulsar.Calibracao). Fixado direto porque ate 10.0.14 tem
         vulnerabilidade alta (GHSA-x33c-w48q-qrgc, corrigida em 10.0.15); nem o
         Resend mais novo (0.25.0) sobe sozinho. Remover quando o pacote pai subir.
         NU1510: na API o framework ja traz o pacote; a referencia existe pelos outros dois. -->
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.15" NoWarn="NU1510" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Resend" Version="0.5.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

</Project>
