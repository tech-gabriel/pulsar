# Modelo do .env da VPS (~/pulsar/.env, chmod 600). Nunca commitar o .env de verdade.
# Push__* e Jwt__SecretKey: nunca trocar sem motivo (chave nova invalida as inscrições
# de push e desloga todo mundo).

# Gravada pelo deploy.sh a cada deploy
TAG=
# Domínio servido pelo Caddy
SITE_DOMAIN=app-pulsar.com.br

# Postgres (senha alfanumérica)
POSTGRES_USER=pulsar
POSTGRES_PASSWORD=
POSTGRES_DB=pulsar

# Backup (backup.sh)
HEALTHCHECKS_URL=

# API
Email__Provider=Resend
Email__FromName=Pulsar
Email__ApiKey=
Email__FromEmail=
Jwt__SecretKey=
OpenWeatherMap__ApiKey=
MapTiler__ApiKey=
Authentication__Google__ClientId=
Push__PublicKey=
Push__PrivateKey=
Push__Subject=
Cors__AllowedOrigins__0=https://app-pulsar.com.br
RecuperacaoSenha__UrlBaseFrontend=https://app-pulsar.com.br
