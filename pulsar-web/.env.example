# MapTiler API key — obtenha em https://cloud.maptiler.com/account/keys/
# Sem esta key, o mapa usa o fallback CartoDB Dark Matter automaticamente.
VITE_MAPTILER_KEY=

# Google OAuth Client ID (Web) — Google Cloud Console > Credenciais.
# Adicione a origem do frontend em "Authorized JavaScript origins"
# (ex.: http://localhost:5174 em dev e o domínio de produção).
# Vazio = botão "Entrar com Google" não aparece. Use o MESMO valor no backend
# em Authentication:Google:ClientId.
VITE_GOOGLE_CLIENT_ID=
